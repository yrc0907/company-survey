# DOMAIN、APP_USERNAME 和 CADDY_BASIC_AUTH_HASH 来自 docker-compose 的服务器环境变量。
# CADDY_BASIC_AUTH_HASH 必须是 `caddy hash-password` 生成的哈希，禁止填入明文密码。
{$DOMAIN} {
    encode zstd gzip

    # 不返回版本信息，并为浏览器建立保守的默认安全边界。
    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
        Cross-Origin-Opener-Policy "same-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    # 健康检查不返回业务信息，供外部监控和部署验收使用。
    @health path /healthz
    handle @health {
        respond "ok" 200
    }

    # 公开 AI 只读入口使用应用内输入限制与单实例限流；其余旧版个人 Research API 仍由 Basic Auth 保护。
    @publicResearchAssistant path /api/research/assistant
    handle @publicResearchAssistant {
        reverse_proxy app:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # 旧版个人 Research Workbench API 仍由 Basic Auth 保护，避免公开平台上线时裸露旧写接口。
    @legacyResearch path /api/research/*
    handle @legacyResearch {
        basic_auth {
            {$APP_USERNAME} {$CADDY_BASIC_AUTH_HASH}
        }

        reverse_proxy app:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # 开放平台公开读接口、Auth.js 和受自身权限保护的 API 对游客可达。
    # 平台写接口必须在应用层校验 Session，不能把 Caddy Basic Auth 当作业务授权。
    handle {
        reverse_proxy app:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}

# Public deployment. Replace every `replace-me` value only in the server .env.
DOMAIN=replace-me.example.com
APP_USERNAME=researcher
CADDY_BASIC_AUTH_HASH=replace-me-caddy-bcrypt-hash

# PostgreSQL: production uses the Docker service name; local development may override it.
POSTGRES_DB=research_workbench
POSTGRES_USER=research
POSTGRES_PASSWORD=replace-me-postgres-password
DATABASE_URL=postgres://research:replace-me-postgres-password@postgres:5432/research_workbench

# Auth.js. Generate NEXTAUTH_SECRET with a cryptographically secure random generator.
NEXTAUTH_URL=https://replace-me.example.com
NEXTAUTH_SECRET=replace-me-auth-secret
# GitHub OAuth is optional; when either value is empty the GitHub login button/provider is disabled.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Real email/SMS/CAPTCHA providers. Keep every secret empty in Git; set only in the server .env.
EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
AUTH_CHALLENGE_PEPPER=replace-me-verification-pepper
AUTH_CODE_EXPIRE_MINUTES=10
# VerificationService 的 PostgreSQL 兜底限流窗口；公开规模可替换为 Redis 实现同一接口。
AUTH_RATE_LIMIT_WINDOW_SECONDS=3600
AUTH_RATE_LIMIT_DESTINATION_MAX=10
AUTH_RATE_LIMIT_IP_MAX=40
AUTH_RATE_LIMIT_DEVICE_MAX=20
CAPTCHA_REQUIRED=true
CAPTCHA_PROVIDER=disabled
ALIYUN_CAPTCHA_API_URL=
ALIYUN_CAPTCHA_APP_ID=
ALIYUN_CAPTCHA_APP_KEY=
ALIYUN_CAPTCHA_TIMEOUT_MS=5000
SMS_PROVIDER=disabled
ALIYUN_SMS_API_URL=
ALIYUN_SMS_APP_ID=
ALIYUN_SMS_APP_KEY=
ALIYUN_SMS_SCHEME_CODE=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=100001
ALIYUN_SMS_TIMEOUT_MS=8000

# OpenAI-compatible model provider. Keep the real API key out of Git and chat history.
MODEL_API_BASE_URL=https://v2.cloudmist.cloud/v1
MODEL_API_KEY=
MODEL_NAME=gpt-5.6-terra
MODEL_REASONING_EFFORT=medium

# Hybrid retrieval providers. The embedding endpoint was verified to return 3072 dimensions.
EMBEDDING_PROVIDER=remote
EMBEDDING_API_BASE_URL=https://v2.cloudmist.cloud/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2-preview
EMBEDDING_DIMENSIONS=3072
EMBEDDING_TIMEOUT_MS=25000
# pgvector 可选持久化：auto 会先探测数据库扩展/列；标准 postgres 镜像缺扩展时自动降级 FTS。
PGVECTOR_ENABLED=auto
# 仅索引 Worker/明确批处理应开启；用户检索请求默认只读已存在向量。
PGVECTOR_WRITE_ENABLED=false
PGVECTOR_EMBEDDING_VERSION=v1
RERANK_API_BASE_URL=https://v2.cloudmist.cloud/v1
# Empty means reuse EMBEDDING_API_KEY. Never put a real API Key in this file.
RERANK_API_KEY=
RERANK_MODEL=qwen3-rerank
RERANK_FALLBACK_MODELS=Pro/BAAI/bge-reranker-v2-m3,BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT_MS=25000
RERANK_ENABLED=true

# Local-only BGE-M3 fallback. Do not enable it on the cloud server or in Docker Compose.
LOCAL_BGE_M3_WORKER_URL=http://127.0.0.1:8787
LOCAL_BGE_M3_WORKER_TOKEN=
LOCAL_BGE_M3_MODEL=BAAI/bge-m3

# Optional direct DeepSeek provider. Configure the rotated key only in the server .env.
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_REASONING_EFFORT=medium
DEEPSEEK_NATIVE_WEB_SEARCH_ENABLED=false

# Search defaults to a verified model-native protocol. Do not configure Bocha until needed.
SEARCH_GLOBAL_PROVIDER=deepseek_native_web
SEARCH_DOMESTIC_PROVIDER=disabled
SEARCH_DOMESTIC_API_BASE_URL=
SEARCH_DOMESTIC_API_KEY=
BOCHA_SEARCH_ENABLED=false
BOCHA_API_BASE_URL=
BOCHA_API_KEY=

# File storage for the small personal server.
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=12

# Reserved for the open knowledge platform; the current app does not read these values yet.
# The ECS instance obtains temporary credentials from the bound RAM role. Do not add AccessKey secrets.
OSS_AUTH_MODE=ecs_ram_role
OSS_RAM_ROLE_NAME=research-oss
OSS_BUCKET=reaserch
OSS_REGION=cn-shanghai
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_FORCE_HTTPS=true
# 开放平台每个用户的 OSS 原件预占配额；上传意图会在服务端先校验，失败对象不计入。
PLATFORM_UPLOAD_USER_QUOTA_BYTES=524288000
